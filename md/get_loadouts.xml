<?xml version="1.0" encoding="utf-8"?>
<mdscript name="GetShipLoadoutsInfo" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">

  <cues>
    <cue name="Init" version="200">
      <conditions>
        <event_cue_signalled cue="md.Setup.Start" />
      </conditions>
      <actions>
        <include_actions ref="md.LSRBetterThanOld.ReadDebugChances" />
        <debug_text text="'LSRBTO: GetShipLoadoutsInfo Init'" chance="$debugChance" />
        <include_actions ref="InitVariables" />
        <include_actions ref="md.LSRBetterThanOld.ClearDebugChances" />
      </actions>
      <patch sinceversion="200">
        <include_actions ref="md.LSRBetterThanOld.ReadDebugChances" />
        <debug_text text="'LSRBTO: GetShipLoadoutsInfo Init: applied patch to version 2.00'" chance="$debugChance" />
        <include_actions ref="InitVariables" />
        <debug_text text="'LSRBTO: GetShipLoadoutsInfo Init: after patch: cacheLifetime: %s, loadoutIds: %s'.[@$cacheLifetime, @$loadoutIds]" chance="$debugChance" />
        <include_actions ref="md.LSRBetterThanOld.ClearDebugChances" />
      </patch>
      <cues>

        <library name="InitVariables" version="200">
          <actions>
            <do_if value="$loadoutIds? and typeof @$loadoutIds == datatype.table" negate="true">
              <set_value name="$loadoutIds" exact="table[]" />
            </do_if>
            <!-- Seconds a cached loadout id stays valid before it is re-requested from Lua. -->
            <set_value name="$cacheLifetime" exact="60" />
            <!-- Pre-200 cache: three parallel lists holding every saved loadout per macro. Convert the still-fresh entries to $loadoutIds, then drop them. -->
            <do_if value="player.gameversion lt 900">
              <do_if
                value="$GSLDataLoadoutsIndex? and $GSLDataLoadouts? and $GSLDataLoadoutsUpdated?
                  and $GSLDataLoadoutsIndex.count gt 0
                  and $GSLDataLoadoutsIndex.count == $GSLDataLoadouts.count
                  and $GSLDataLoadoutsIndex.count == $GSLDataLoadoutsUpdated.count">
                <do_for_each name="$oldMacroName" in="$GSLDataLoadoutsIndex" counter="$oldIndex">
                  <set_value name="$oldMacro" exact="macro.{$oldMacroName}" />
                  <do_if value="$oldMacro and player.age - $GSLDataLoadoutsUpdated.{$oldIndex} le $cacheLifetime">
                    <do_for_each name="$oldLoadout" in="$GSLDataLoadouts.{$oldIndex}">
                      <!-- Mirrors the Lua constant lsrbto.replacementLoadoutName; needed here only to read pre-200 data. -->
                      <do_if value="$oldLoadout.$name == 'ReplacementShip'">
                        <set_value name="$loadoutIds.{$oldMacro}" exact="table[$id = $oldLoadout.$id, $age = $GSLDataLoadoutsUpdated.{$oldIndex}]" />
                        <debug_text text="'LSRBTO: GSLI_Init [%s]: converted pre-200 cache entry: macro: %s, loadout: %s'.[player.age, $oldMacro, $oldLoadout.$id]"
                          chance="$traceChance" />
                        <break />
                      </do_if>
                    </do_for_each>
                  </do_if>
                  <remove_value name="$oldMacro" />
                </do_for_each>
              </do_if>
            </do_if>
            <do_if value="$GSLDataLoadouts?">
              <remove_value name="$GSLDataLoadouts" />
            </do_if>
            <do_if value="$GSLDataLoadoutsIndex?">
              <remove_value name="$GSLDataLoadoutsIndex" />
            </do_if>
            <do_if value="$GSLDataLoadoutsUpdated?">
              <remove_value name="$GSLDataLoadoutsUpdated" />
            </do_if>
          </actions>
        </library>

        <library name="RequestLoadoutId" version="200">
          <!-- In: $getLoadoutByMacro. Leaves the debug chances set: every caller clears them itself. -->
          <actions>
            <include_actions ref="md.LSRBetterThanOld.ReadDebugChances" />
            <debug_text text="'LSRBTO: RequestLoadoutId [%s]: macro: %s'.[player.age, $getLoadoutByMacro]" chance="$traceChance" />
            <raise_lua_event name="'LSRBTO.GetLoadoutId'" param="'%s'.[$getLoadoutByMacro]" />
          </actions>
        </library>

        <cue name="LoadoutIdResult" instantiate="true" version="200">
          <conditions>
            <event_ui_triggered screen="'LSRBTO.LoadoutId'" control="'Result'" />
            <check_value value="@event.param3.$macro and @event.param3.$id" />
          </conditions>
          <actions>
            <include_actions ref="md.LSRBetterThanOld.ReadDebugChances" />
            <set_value name="$macro" exact="macro.{@event.param3.$macro}" />
            <set_value name="$loadoutId" exact="@event.param3.$id" />
            <debug_text text="'LSRBTO: LoadoutIdResult [%s]: macro: %s, loadout: %s, table: %s'.[player.age, $macro, @$loadoutId, @$loadoutIds]" chance="$traceChance" />
            <do_if value="$macro">
              <set_value name="$loadoutIds.{$macro}" exact="table[$id = @$loadoutId, $age = player.age]" />
              <debug_text text="'LSRBTO: LoadoutIdResult [%s]: macro: %s, loadout in table: %s'.[player.age, $macro, @$loadoutIds.{$macro}.$id]" chance="$debugChance" />
            </do_if>
            <do_else>
              <debug_text text="'LSRBTO: LoadoutIdResult [%s]: unknown macro: %s'.[player.age, @event.param3.$macro]" chance="$debugChance" />
            </do_else>
            <remove_value name="$macro" />
            <remove_value name="$loadoutId" />
            <include_actions ref="md.LSRBetterThanOld.ClearDebugChances" />
          </actions>
        </cue>

        <cue name="ProcessShipLoadoutRequest" instantiate="true" namespace="this" version="200">
          <conditions>
            <event_object_signalled object="player.entity" param="'get_ship_loadouts_by_macro'" />
            <check_value value="@event.param2" />
          </conditions>
          <actions>
            <include_actions ref="md.LSRBetterThanOld.ReadDebugChances" />
            <debug_text text="'LSRBTO: ProcessShipLoadoutRequest [%s]: macro: %s'.[player.age, @event.param2]" chance="$debugChance" />
            <set_value name="$getLoadoutByMacro" exact="@event.param2" />
            <include_actions ref="md.GetShipLoadoutsInfo.RequestLoadoutId" />
            <remove_value name="$getLoadoutByMacro" />
            <include_actions ref="md.LSRBetterThanOld.ClearDebugChances" />
          </actions>
        </cue>

        <library name="GetShipLoadout" version="200">
          <!-- In: $getLoadoutByMacro. Out: $replacementLoadoutId, $replacementLoadout - both null when nothing is cached yet.
               Leaves the debug chances set: the caller clears them along with GetShipLoadoutClearance. -->
          <actions>
            <include_actions ref="md.LSRBetterThanOld.ReadDebugChances" />
            <set_value name="$replacementLoadoutId" exact="null" />
            <set_value name="$replacementLoadout" exact="null" />
            <set_value name="$cachedLoadout" exact="@md.GetShipLoadoutsInfo.Init.$loadoutIds.{$getLoadoutByMacro}" />
            <debug_text text="'LSRBTO: GetShipLoadout [%s]: macro: %s, cached loadout: %s'.[player.age, $getLoadoutByMacro, @$cachedLoadout]" chance="$traceChance" />
            <do_if value="$cachedLoadout">
              <set_value name="$replacementLoadoutId" exact="$cachedLoadout.$id" />
              <get_loadout result="$replacementLoadout" loadout="$replacementLoadoutId" macro="$getLoadoutByMacro" />
            </do_if>
            <!-- Refresh a missing or stale entry for the next call; the Lua answer arrives too late for this one. -->
            <do_if value="$cachedLoadout == null or player.age - $cachedLoadout.$age gt md.GetShipLoadoutsInfo.Init.$cacheLifetime">
              <include_actions ref="md.GetShipLoadoutsInfo.RequestLoadoutId" />
            </do_if>
            <remove_value name="$cachedLoadout" />
            <debug_text
              text="'LSRBTO: GetShipLoadout [%s]: macro: %s, loadout: %s, wares count: %s'.
              [player.age, $getLoadoutByMacro, @$replacementLoadoutId, @$replacementLoadout.wares.count]"
              chance="$debugChance"
            />
          </actions>
        </library>

        <library name="GetShipLoadoutClearance" version="200">
          <actions>
            <remove_value name="$replacementLoadoutId" />
            <remove_value name="$replacementLoadout" />
            <remove_value name="$getLoadoutByMacro" />
          </actions>
        </library>

      </cues>
    </cue>
  </cues>

</mdscript>