<?xml version="1.0" encoding="utf-8"?>
<mdscript name="LSRBetterThanOld" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">

  <cues>
    <cue name="Init" version="200">
      <conditions>
        <event_cue_signalled cue="md.Setup.Start" />
      </conditions>
      <actions>
        <!-- none = off, debug = debug, trace = trace -->
        <include_actions ref="GetDefaultVariables" />
        <debug_text text="'LSRBTO: LSRBetterThanOld Init'" chance="$debugChance" />
      </actions>
      <patch sinceversion="200">
        <include_actions ref="GetDefaultVariables" />
        <debug_text text="'LSRBTO: LSRBetterThanOld Init: applied patch to version 2.00'" chance="$debugChance" />
        <do_if value="$upgradeTasks?">
          <remove_value name="$upgradeTasks" />
        </do_if>
      </patch>

      <cues>

        <library name="GetDefaultVariables" version="200">
          <actions>
            <set_value name="$debugLevel" exact="'trace'" />
            <set_value name="$debugChance" exact="if $debugLevel == 'debug' or $debugLevel == 'trace' then 100 else 0" />
            <set_value name="$traceChance" exact="if $debugLevel == 'trace' then 100 else 0" />
          </actions>
        </library>

        <library name="RequestLoadoutsInfo" version="200">
          <actions>
            <do_if value="player.gameversion lt 900">
              <include_actions ref="md.LSRBetterThanOld.GetDefaultVariables" />
              <debug_text text="'LSRBTO_RequestLoadoutsInfo [%s]: macro: %s'.[player.age, $locship.macro]"
                chance="$debugChance" />
              <set_value name="$getLoadoutByMacro" exact="$locship.macro" />
              <include_actions ref="md.GetShipLoadoutsInfo.RequestLoadoutId" />
              <remove_value name="$getLoadoutByMacro" />
            </do_if>
          </actions>
        </library>

        <library name="MakeBetterThanOld" version="200">
          <actions>
            <do_if value="player.gameversion lt 900">
              <include_actions ref="md.LSRBetterThanOld.GetDefaultVariables" />
              <debug_text
                text="'LSRBTO: MakeBetterThanOld [%s]: Build: Task: %s. Object: %s (%s). Processor: %s (%s). Other: %s (%s).'.
                [
                  player.age,
                  @$buildtask,
                  @$buildtask.buildobject,
                  @$buildtask.buildobject.debugname,
                  @event.param,
                  @event.param.debugname,
                  @event.object,
                  @event.object.debugname
                ]"
                chance="$debugChance"
              />
              <set_value name="$getLoadoutByMacro" exact="$buildtask.buildobject.macro" />
              <include_actions ref="md.GetShipLoadoutsInfo.GetShipLoadout" />
              <do_if value="@$replacementLoadout and @event.object.controlentity.{controlpost.shiptrader}">
                <set_value name="$missingEquipment"
                  exact="@event.object.missingloadoutequipment.{$replacementLoadout}.{$buildtask.buildobject.owner}.list" />
                <debug_text
                  text="'LSRBTO: MakeBetterThanOld [%s]: Going to upgrade %s. Missing equipment: Count: %s. Data: %s'.
                    [player.age, $buildtask.buildobject.debugname, $missingEquipment.count, $missingEquipment]"
                  chance="$debugChance"
                />
                <do_if value="@$missingEquipment.count == 0">
                  <apply_loadout loadout="$replacementLoadout" object="$buildtask.buildobject" />
                </do_if>
                <do_else>
                  <debug_text
                    text="'LSRBTO: MakeBetterThanOld [%s]: Can not apply loadout %s on %s. Due to Missing equipment count: %s'.
                      [player.age, $replacementLoadoutId, $buildtask.buildobject.debugname, $missingEquipment.count]"
                    chance="$debugChance"
                  />
                </do_else>
                <remove_value name="$missingEquipment" />
              </do_if>
              <include_actions ref="md.GetShipLoadoutsInfo.GetShipLoadoutClearance" />
            </do_if>
          </actions>
        </library>
      </cues>
    </cue>
  </cues>

</mdscript>