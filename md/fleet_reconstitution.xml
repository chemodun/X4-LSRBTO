<?xml version="1.0" encoding="utf-8"?>
<diff>
  <add sel="/mdscript/cues/cue/cues" pos="prepend">
    <cue name="PrepareToProcessRequest" instantiate="true" namespace="this">
      <conditions>
        <event_object_signalled object="player.entity" param="'reconstitute_fleet'" />
        <check_value value="event.param2.isclass.controllable" />
        <check_value value="not event.param2.fleetunit" />
        <check_value value="@event.param3.count" />
      </conditions>
      <actions>
        <do_if value="player.gameversion ge 900">
          <set_value name="$commander" exact="@event.param2" />
          <do_if value="$commander.commander">
            <set_value name="$commander" exact="$commander.toplevelcommander" />
          </do_if>
          <do_if value="$commander">
            <raise_lua_event name="'LSRBTO.ProcessBuildTasks'" param="@$commander" />
          </do_if>
          <include_actions ref="md.LSRBetterThanOld.ReadDebugChances" />
          <debug_text
            text="'LSRBTO: PrepareToProcessRequest [%s]: fleet reconstitution requested by %s. Fleet leader: %s in sector %s. Ships to be replaced: %s'.
              [player.age, @event.param2.debugname, @$commander.debugname, @$commander.sector.knownname, @event.param3.count]"
            chance="$debugChance"
          />
          <include_actions ref="md.LSRBetterThanOld.ClearDebugChances" />
          <signal_objects object="player.entity" param="'reconstitute_fleet_confirmed'" param2="event.param2" param3="event.param3" delay="300ms" />
        </do_if>
        <do_else>
          <signal_objects object="player.entity" param="'reconstitute_fleet_confirmed'" param2="event.param2" param3="event.param3" />
        </do_else>
      </actions>
    </cue>
  </add>
  <replace sel="/mdscript/cues/cue/cues/cue[@name='ProcessRequest']/conditions/event_object_signalled/@param">'reconstitute_fleet_confirmed'</replace>
  <add sel="/mdscript/cues/cue/cues/cue[@name='ProcessRequest']/actions/do_if[@value='$shipstobereplaced.count']/do_for_each/do_else/do_for_each/do_if[@value='not $shipyardfails']/add_build_to_rebuild_fleet_ship" pos="after">
    <include_actions ref="md.LSRBetterThanOld.RequestLoadoutsInfo" />
  </add>
  <add sel="/mdscript/cues/cue/cues/cue[@name='ProcessRequest']/cues/cue/cues" pos="prepend">
    <cue name="BuildStarted" instantiate="true">
      <conditions>
        <event_build_started group="$shipyards" />
        <check_value value="$buildtasks.indexof.{event.param3}" />
        <check_value value="player.gameversion ge 900" />
      </conditions>
      <actions>
        <include_actions ref="md.LSRBetterThanOld.ReadDebugChances" />
        <debug_text text="'LSRBTO: BuildStarted: going to rename unit, if needed'" chance="$debugChance" />
        <do_if value="@$commander != null">
          <raise_lua_event name="'LSRBTO.Rename'" param="$commander" />
        </do_if>
        <include_actions ref="md.LSRBetterThanOld.ClearDebugChances" />
      </actions>
    </cue>
  </add>
  <add sel="/mdscript/cues/cue/cues/cue[@name='ProcessRequest']/cues/cue/cues/cue[@name='BuildFinished']/actions/set_value" pos="after">
    <include_actions ref="md.LSRBetterThanOld.MakeBetterThanOld" />
  </add>
</diff>